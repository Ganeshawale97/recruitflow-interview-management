PORT=4000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/recruitflow
DATABASE_SSL=false
# Generate a long random secret (at least 32 characters). Never commit your real .env.
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
# Used only by the one-time npm run create-admin command:
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@recruitflow.local
BOOTSTRAP_ADMIN_NAME=RecruitFlow Administrator
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Optional SMTP settings for automatic candidate QR-pass emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
